rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Imágenes de productos: lectura pública (para que se vean en la web),
    // escritura solo del administrador autenticado.
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                    && request.auth.token.email == "ffabiscake@gmail.com"
                    && request.resource.size < 10 * 1024 * 1024   // máx 10MB por archivo
                    && request.resource.contentType.matches('image/.*');
    }

    // Bloquea todo lo demás.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
