rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Colección de productos.
    match /products/{productId} {
      // Cualquier visitante puede LEER el catálogo (necesario para que
      // la página pública funcione sin iniciar sesión).
      allow read: if true;

      // Solo el administrador autenticado con el correo autorizado
      // puede crear, editar o borrar productos.
      allow create, update, delete: if request.auth != null
                    && request.auth.token.email == "ffabiscake@gmail.com";
    }

    // Bloquea cualquier otra colección por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
